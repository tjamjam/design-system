{
  "name": "@tfradet/design-system",
  "version": "0.2.0",
  "private": true,
  "description": "Themeable component library with brand, company, font, density, and a11y axes.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com:tjamjam/design-system.git"
  },
  "files": [
    "dist",
    "registry",
    "README.md",
    "CLAUDE.md",
    "AGENTS.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./provider": {
      "types": "./dist/components/theme-provider.d.ts",
      "default": "./dist/components/theme-provider.js"
    },
    "./fonts": {
      "types": "./dist/lib/fonts.d.ts",
      "default": "./dist/lib/fonts.js"
    },
    "./companies": {
      "types": "./dist/lib/companies.d.ts",
      "default": "./dist/lib/companies.js"
    },
    "./font-options": {
      "types": "./dist/lib/font-options.d.ts",
      "default": "./dist/lib/font-options.js"
    },
    "./a11y": {
      "types": "./dist/lib/a11y-chart-palette.d.ts",
      "default": "./dist/lib/a11y-chart-palette.js"
    },
    "./utils": {
      "types": "./dist/lib/utils.d.ts",
      "default": "./dist/lib/utils.js"
    },
    "./ui/*": {
      "types": "./dist/components/ui/*.d.ts",
      "default": "./dist/components/ui/*.js"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "registry:build": "shadcn build",
    "extract:brand": "tsx scripts/extract-brand.ts",
    "build:pkg": "tsc -p tsconfig.build.json && node scripts/bundle-styles.mjs",
    "prepare": "npm run build:pkg",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "next": ">=15",
    "next-themes": ">=0.4",
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": ">=4"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "colord": "^2.9.3",
    "lucide-react": "^1.8.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.3.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cheerio": "^1.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.4"
  }
}
